# ---------------------------------------------------------------------------
# NutriPals — environment template. Copy to .env and fill in what you need.
# Never commit a real .env file.
# ---------------------------------------------------------------------------

# Server
PORT=8787
NODE_ENV=development
# Origin of the web app. Used for session cookies and same-origin checks.
APP_ORIGIN=http://localhost:5173
# Comma-separated origins permitted to make state-changing requests.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787
# SQLite file. Relative paths resolve from apps/server.
DATABASE_PATH=./data/nutripals.db
# Set true only when serving over HTTPS.
SESSION_COOKIE_SECURE=false
# Development convenience: return verification/reset tokens in API responses.
# MUST be false in production (no email provider is bundled).
EXPOSE_DEV_TOKENS=true
# Optional: serve the built web app from the API server.
SERVE_WEB=false
WEB_DIST_PATH=../web/dist

# ---------------------------------------------------------------------------
# AI food-photo analysis — configure ONE provider to enable the scanner.
# Leave AI_PROVIDER=none to run the app with a clear "not configured" state.
# ---------------------------------------------------------------------------
AI_PROVIDER=none

# OpenAI (or any OpenAI-compatible chat-completions endpoint that accepts images)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Nutrition data sources
# ---------------------------------------------------------------------------
# Open Food Facts requires no key. Set to false to disable external calls.
ENABLE_OPEN_FOOD_FACTS=true
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
# App identification, as required by the Open Food Facts API guidelines.
OFF_USER_AGENT=NutriPals/0.1 (https://example.org/nutripals; contact@example.org)

# USDA FoodData Central (free key from https://fdc.nal.usda.gov/api-key-signup.html)
USDA_FDC_API_KEY=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=8

# Optional: Google OAuth is not wired up in this build (see README limitations)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
